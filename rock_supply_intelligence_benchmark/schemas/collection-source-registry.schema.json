{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rock Supply Intelligence Collection Source Registry v1",
  "type": "object",
  "required": ["schema_version", "registry_id", "sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "registry_id": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "enabled", "publisher", "domain", "adapter", "rate_limit_s", "max_retries", "candidates"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "enabled": {"type": "boolean"},
          "publisher": {"type": "string"},
          "domain": {"type": "string"},
          "adapter": {"const": "direct_urls"},
          "rate_limit_s": {"type": "number", "minimum": 0},
          "max_retries": {"type": "integer", "minimum": 0, "maximum": 5},
          "license": {"type": ["string", "null"]},
          "access_constraints": {"type": ["string", "null"]},
          "discovery": {
            "type": "object",
            "required": ["index_urls", "profiles"],
            "properties": {
              "index_urls": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "pattern": "^https://"}
              },
              "max_links_per_index": {"type": "integer", "minimum": 1, "maximum": 100},
              "profiles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["profile_id", "path_prefixes", "include_terms", "candidate_template"],
                  "properties": {
                    "profile_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
                    "path_prefixes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^/"}},
                    "exclude_path_prefixes": {"type": "array", "items": {"type": "string", "pattern": "^/"}},
                    "min_path_segments": {"type": "integer", "minimum": 1, "maximum": 20},
                    "require_url_date_match": {"type": "boolean"},
                    "not_before": {"type": "string", "format": "date-time"},
                    "include_terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
                    "candidate_template": {
                      "type": "object",
                      "required": ["language", "primary_class", "event_category", "event_type", "expected_disposition", "accept_terms"],
                      "properties": {
                        "language": {"enum": ["en", "zh-TW", "mixed"]},
                        "primary_class": {"enum": ["materially_relevant", "monitor", "irrelevant"]},
                        "event_category": {"type": "string"},
                        "event_type": {"type": "string"},
                        "expected_disposition": {"enum": ["normalize", "monitor", "suppress", "abstain", "quarantine"]},
                        "accept_terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}}
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["sample_id", "url", "title", "published_at", "language", "primary_class", "event_category", "event_type", "expected_disposition", "accept_terms"],
              "properties": {
                "sample_id": {"type": "string", "pattern": "^ATOM-[A-Z0-9-]+$"},
                "url": {"type": "string", "pattern": "^https://"},
                "title": {"type": "string"},
                "published_at": {"type": "string", "format": "date-time"},
                "language": {"enum": ["en", "zh-TW", "mixed"]},
                "primary_class": {"enum": ["materially_relevant", "monitor", "irrelevant"]},
                "event_category": {"type": "string"},
                "event_type": {"type": "string"},
                "expected_disposition": {"enum": ["normalize", "monitor", "suppress", "abstain", "quarantine"]},
                "preferred_split": {"enum": ["auto", "dev", "selection", "holdout"]},
                "accept_terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
