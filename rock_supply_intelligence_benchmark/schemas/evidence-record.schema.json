{
  "$defs": {
    "ExternalId": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "system",
        "value"
      ],
      "title": "ExternalId",
      "type": "object"
    },
    "ExtractionTrace": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "deterministic",
            "local_ai",
            "cloud_ai",
            "human",
            "pending"
          ],
          "title": "Method",
          "type": "string"
        },
        "model_or_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Or Rule"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "execution_class": {
          "anyOf": [
            {
              "enum": [
                "local",
                "cloud",
                "human",
                "deterministic",
                "pending"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Class"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        }
      },
      "required": [
        "method"
      ],
      "title": "ExtractionTrace",
      "type": "object"
    },
    "SourceQuality": {
      "additionalProperties": false,
      "description": "Canonical quality object attached to a filtered source / Evidence.",
      "properties": {
        "spam_class": {
          "title": "Spam Class",
          "type": "string"
        },
        "quality_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Quality Score",
          "type": "number"
        },
        "spam_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Spam Score",
          "type": "number"
        },
        "operational_value_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Operational Value Score",
          "type": "number"
        },
        "duplicate_probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Duplicate Probability",
          "type": "number"
        },
        "prompt_injection_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Prompt Injection Score",
          "type": "number"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "decision": {
          "enum": [
            "accept",
            "accept_with_penalty",
            "quarantine",
            "reject",
            "review"
          ],
          "title": "Decision",
          "type": "string"
        },
        "method": {
          "default": "deterministic",
          "enum": [
            "deterministic",
            "hybrid",
            "local_ai",
            "human"
          ],
          "title": "Method",
          "type": "string"
        },
        "model_used": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Used"
        }
      },
      "required": [
        "spam_class",
        "quality_score",
        "spam_score",
        "operational_value_score",
        "duplicate_probability",
        "prompt_injection_score",
        "decision"
      ],
      "title": "SourceQuality",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Append-only observation record. Material claims must cite Evidence IDs.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "default": "sunlighten-shadow",
      "title": "Tenant Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "superseded",
        "retracted",
        "archived",
        "draft"
      ],
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "external_ids": {
      "items": {
        "$ref": "#/$defs/ExternalId"
      },
      "title": "External Ids",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "source_name": {
      "title": "Source Name",
      "type": "string"
    },
    "source_type": {
      "enum": [
        "authoritative_feed",
        "government",
        "open_data",
        "news",
        "satellite",
        "community",
        "internal",
        "analyst"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "source_locator": {
      "title": "Source Locator",
      "type": "string"
    },
    "publisher": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publisher"
    },
    "source_authority": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Authority"
    },
    "retrieved_at": {
      "title": "Retrieved At",
      "type": "string"
    },
    "published_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "observed_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed At"
    },
    "effective_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective At"
    },
    "content_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Hash"
    },
    "hash_method": {
      "anyOf": [
        {
          "const": "sha256",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "sha256",
      "title": "Hash Method"
    },
    "raw_ref": {
      "title": "Raw Ref",
      "type": "string"
    },
    "excerpt_or_payload_path": {
      "title": "Excerpt Or Payload Path",
      "type": "string"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "access_constraints": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Access Constraints"
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    },
    "extraction": {
      "$ref": "#/$defs/ExtractionTrace"
    },
    "source_quality": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceQuality"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes"
    },
    "retracts": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retracts"
    }
  },
  "required": [
    "id",
    "status",
    "created_at",
    "updated_at",
    "source_name",
    "source_type",
    "source_locator",
    "retrieved_at",
    "raw_ref",
    "excerpt_or_payload_path",
    "extraction"
  ],
  "title": "Canonical Evidence v0.1",
  "type": "object"
}
