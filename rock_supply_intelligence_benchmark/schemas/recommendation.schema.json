{
  "$defs": {
    "ExecutionRecord": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "time": {
          "title": "Time",
          "type": "string"
        },
        "external_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Ref"
        }
      },
      "required": [
        "actor",
        "time"
      ],
      "title": "ExecutionRecord",
      "type": "object"
    },
    "ExternalId": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "system",
        "value"
      ],
      "title": "ExternalId",
      "type": "object"
    },
    "HumanApproval": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "not_requested",
            "pending",
            "approved",
            "rejected"
          ],
          "title": "State",
          "type": "string"
        },
        "actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor"
        },
        "at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "state"
      ],
      "title": "HumanApproval",
      "type": "object"
    },
    "ModelTrace": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "execution_class": {
          "enum": [
            "local",
            "cloud"
          ],
          "title": "Execution Class",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "model",
        "provider",
        "execution_class",
        "prompt_version"
      ],
      "title": "ModelTrace",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Advisory recommendation draft. Requires explicit human approval before any operational action.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "default": "sunlighten-shadow",
      "title": "Tenant Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "superseded",
        "retracted",
        "archived",
        "draft"
      ],
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "external_ids": {
      "items": {
        "$ref": "#/$defs/ExternalId"
      },
      "title": "External Ids",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "exposure_ids": {
      "items": {
        "type": "string"
      },
      "title": "Exposure Ids",
      "type": "array"
    },
    "action_type": {
      "enum": [
        "monitor",
        "verify",
        "contact_carrier",
        "expedite_review",
        "allocate_review",
        "alternate_route_review",
        "customer_commitment_review",
        "compliance_review",
        "no_action"
      ],
      "title": "Action Type",
      "type": "string"
    },
    "recommendation_status": {
      "default": "draft",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "rejected",
        "executed",
        "withdrawn"
      ],
      "title": "Recommendation Status",
      "type": "string"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "priority": {
      "default": "medium",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "title": "Priority",
      "type": "string"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "human_approval": {
      "$ref": "#/$defs/HumanApproval"
    },
    "execution_record": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model_trace": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelTrace"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "status",
    "created_at",
    "updated_at",
    "exposure_ids",
    "action_type",
    "rationale",
    "human_approval"
  ],
  "title": "Canonical Recommendation v0.1",
  "type": "object"
}
