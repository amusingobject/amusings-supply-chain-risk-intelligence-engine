{
  "$defs": {
    "ExternalId": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "system",
        "value"
      ],
      "title": "ExternalId",
      "type": "object"
    },
    "PurchaseOrderLine": {
      "additionalProperties": false,
      "properties": {
        "sku_id": {
          "title": "Sku Id",
          "type": "string"
        },
        "quantity_ordered": {
          "exclusiveMinimum": 0,
          "title": "Quantity Ordered",
          "type": "number"
        },
        "unit_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Cost"
        },
        "promised_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promised Date"
        },
        "received_quantity": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Received Quantity"
        }
      },
      "required": [
        "sku_id",
        "quantity_ordered"
      ],
      "title": "PurchaseOrderLine",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "default": "sunlighten-shadow",
      "title": "Tenant Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "superseded",
        "retracted",
        "archived",
        "draft"
      ],
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "external_ids": {
      "items": {
        "$ref": "#/$defs/ExternalId"
      },
      "title": "External Ids",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "po_number": {
      "title": "Po Number",
      "type": "string"
    },
    "supplier_id": {
      "title": "Supplier Id",
      "type": "string"
    },
    "order_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Order Date"
    },
    "po_status": {
      "default": "open",
      "enum": [
        "draft",
        "open",
        "partially_received",
        "received",
        "cancelled",
        "closed"
      ],
      "title": "Po Status",
      "type": "string"
    },
    "currency": {
      "default": "USD",
      "title": "Currency",
      "type": "string"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/PurchaseOrderLine"
      },
      "title": "Lines",
      "type": "array"
    },
    "ship_to_location_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ship To Location Id"
    },
    "incoterm": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Incoterm"
    }
  },
  "required": [
    "id",
    "status",
    "created_at",
    "updated_at",
    "po_number",
    "supplier_id",
    "lines"
  ],
  "title": "Canonical PurchaseOrder v0.1",
  "type": "object"
}
