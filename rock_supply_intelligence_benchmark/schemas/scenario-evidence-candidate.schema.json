{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario evidence candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "scenario_id", "state", "source", "supported_claims", "excerpt", "reviewer"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["discovered", "captured", "verified", "reviewed", "rejected", "escalated"]},
    "source": {"type": "object", "required": ["publisher", "locator", "raw_ref", "content_hash", "published_at"], "properties": {"publisher": {"type": "string"}, "locator": {"type": "string"}, "raw_ref": {"type": "string"}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "published_at": {"type": "string"}}},
    "supported_claims": {"type": "array", "minItems": 1, "items": {"enum": ["weather", "port_operations", "port_disruption", "carrier_service", "carrier_exception", "infrastructure", "labor", "geopolitical", "road_disruption", "wildfire"]}},
    "excerpt": {"type": "string", "minLength": 1},
    "reviewer": {"type": ["string", "null"]}
  }
}
